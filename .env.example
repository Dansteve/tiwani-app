# tiwani-app environment (template). Copy to .env.local and fill in. NEVER commit real values.
# All keys are NEXT_PUBLIC_* because they are read in the browser (the app is a static PWA).

# Base URL of tiwani-api (no trailing slash). Dev example: http://localhost:8002
NEXT_PUBLIC_API_URL=

# Supabase project (Supabase Auth + the api's data layer). From the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The marketing website URL the app links "Back to home" to (dev: http://localhost:5174)
NEXT_PUBLIC_WEBSITE_URL=
